{
    "mcp_servers": {
      "time": {
        "command": "uvx",
        "args": ["--from", "mcp-server-time", "python", "-m", "mcp_server_time", "--local-timezone=Asia/Kolkata"]
      },
      "ddg-search": {
        "command": "uvx",
        "args": ["--from", "duckduckgo-mcp-server", "python", "-c", "from duckduckgo_mcp_server.server import main; main()"]
      }
    }
}
